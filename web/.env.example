# Salin file ini menjadi .env.local lalu isi nilai konfigurasi resmi Firebase & Google OAuth Anda.
# Jangan memasukkan kredensial produksi langsung ke repositori git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Google OAuth Client ID untuk unggahan Google Drive Web (GIS)
VITE_GOOGLE_DRIVE_CLIENT_ID=
